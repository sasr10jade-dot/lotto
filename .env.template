# Google Gemini API Key
# 발급처: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 발송용 이메일 SMTP 설정 (Gmail 권장)
# Gmail 사용 시 '앱 비밀번호(App Password)'를 생성하여 등록해야 합니다.
SENDER_EMAIL=your_sender_gmail_here@gmail.com
SENDER_PASSWORD=your_gmail_app_password_here

# 수신용 이메일 설정
RECEIVER_EMAIL=your_recipient_email_here@domain.com

# SMTP 서버 정보 (기본값 Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
